@model List<MirrorSea.Models.Article>
@{
    ViewData["Title"] = "專欄文章";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold" style="color:#1E1E1E;">專欄文章</h1>
        <p class="text-muted">方泊 · 心理與生活的溫柔知識</p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">目前尚無公開文章</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var article in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0" style="background-color:#F9F5F0;">
                        @if (!string.IsNullOrEmpty(article.CoverImageUrl))
                        {
                            <img src="@article.CoverImageUrl" class="card-img-top"
                                 style="height:180px; object-fit:cover;" alt="@article.Title">
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@article.Title</h5>
                            <p class="card-text text-muted small flex-grow-1">
                                @(article.Summary ?? (article.Content.Length > 80 ? article.Content.Substring(0, 80) + "..." : article.Content))
                            </p>
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <small class="text-muted">@article.AuthorName</small>
                                <small class="text-muted">@article.PublishedAt?.ToString("yyyy-MM-dd")</small>
                            </div>
                            <a asp-action="ArticleDetail" asp-route-id="@article.Id"
                               class="btn btn-sm btn-outline-dark mt-3">閱讀全文</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
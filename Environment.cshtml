@{
    ViewData["Title"] = "環境簡介 - 方泊 鏡海";
}

<div class="container py-4 py-md-5">
    <!-- 標題（與首頁一致） -->
    <div class="text-center mb-4 mb-md-5 px-2">
        <h1 class="fw-bold mb-2" style="color:#1E1E1E;">環境簡介</h1>
        <p class="lead mb-0" style="color:#8C6E5A;">安靜、溫暖的等候與諮商空間</p>
    </div>

    <!-- 簡介 -->
    <div class="card border-0 shadow-sm mb-4" style="background-color:#F9F5F0;">
        <div class="card-body p-3 p-md-4">
            <p class="mb-2">
                方泊心理諮商所位於高雄市三民區，提供獨立、隱私且舒適的諮商環境。
                從等候區到諮商室，皆以柔和色調與安靜氛圍設計，讓來談者能安心停留、被好好傾聽。
            </p>
            <p class="mb-0 text-muted small">
                以下為諮商所實際空間照片，實際配置以現場為準。
            </p>
        </div>
    </div>

    <!-- 等候空間 -->
    <h5 class="mb-3" style="color:#8C6E5A;">等候空間</h5>
    <div class="row g-3 g-md-4 mb-4">
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 env-card">
                <img src="~/images/env/等候空間 (1).jpg"
                     class="card-img-top env-photo"
                     alt="等候空間一" />
                <div class="card-body py-2 px-3">
                    <p class="small text-muted mb-0">等候區</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 env-card">
                <img src="~/images/env/等候空間 (2).jpg"
                     class="card-img-top env-photo"
                     alt="等候空間二" />
                <div class="card-body py-2 px-3">
                    <p class="small text-muted mb-0">等候區</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 env-card">
                <img src="~/images/env/等候空間 (3).jpg"
                     class="card-img-top env-photo"
                     alt="等候空間三" />
                <div class="card-body py-2 px-3">
                    <p class="small text-muted mb-0">等候區</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 諮商空間 -->
    <h5 class="mb-3" style="color:#8C6E5A;">諮商空間</h5>
    <div class="row g-3 g-md-4 mb-4">
        <div class="col-12 col-sm-6">
            <div class="card h-100 shadow-sm border-0 env-card">
                <img src="~/images/env/諮商空間 (1).jpg"
                     class="card-img-top env-photo"
                     alt="諮商空間一" />
                <div class="card-body py-2 px-3">
                    <p class="small text-muted mb-0">諮商室</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6">
            <div class="card h-100 shadow-sm border-0 env-card">
                <img src="~/images/env/諮商空間 (2).jpg"
                     class="card-img-top env-photo"
                     alt="諮商空間二" />
                <div class="card-body py-2 px-3">
                    <p class="small text-muted mb-0">諮商室</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 位置與營業時間 -->
    <div class="row g-3 g-md-4 mb-4">
        <div class="col-12 col-md-6">
            <div class="card h-100 shadow-sm border-0" style="background-color:#F2E6D2;">
                <div class="card-body p-3 p-md-4">
                    <h5 class="mb-3" style="color:#8C6E5A;">位置</h5>
                    <p class="mb-1"><strong>地址</strong></p>
                    <a href="https://maps.app.goo.gl/pUnbRrGkPmbCdD1d9" target="_blank" rel="noopener" class="l-link">
                        高雄市三民區建元路56號2樓
                    </a>
                    <p class="mb-0 small text-muted">
                        鄰近環狀輕軌相關站點，建議提前預約並預留交通時間。
                    </p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card h-100 shadow-sm border-0" style="background-color:#F2E6D2;">
                <div class="card-body p-3 p-md-4">
                    <h5 class="mb-3" style="color:#8C6E5A;">營業時間</h5>
                    <p class="mb-1">週一至週日</p>
                    <p class="mb-1">09:00～12:00</p>
                    <p class="mb-1">14:00～17:00</p>
                    <p class="mb-0">18:00～21:00</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 到訪提醒 -->
    <div class="card border-0 shadow-sm mb-4" style="background-color:#F9F5F0;">
        <div class="card-body p-3 p-md-4">
            <h5 class="mb-3" style="color:#8C6E5A;">到訪提醒</h5>
            <ul class="mb-0 ps-3 small">
                <li class="mb-2">服務採預約制，請依約定時間到達。</li>
                <li class="mb-2">空間以安靜為主，請避免大聲通話或錄音錄影。</li>
                <li class="mb-2">會談內容受專業倫理保護。</li>
                <li>若有無障礙或其他特殊需求，歡迎事先告知。</li>
            </ul>
        </div>
    </div>

    <!-- 底部按鈕（與首頁快速功能同樣響應式） -->
    <div class="d-flex flex-column flex-sm-row flex-wrap gap-2 justify-content-center">
        <a asp-controller="Home" asp-action="Contact" class="btn btn-primary">聯絡我們</a>
        <a asp-controller="Home" asp-action="Team" class="btn btn-outline-dark">認識諮商團隊</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">返回首頁</a>
    </div>
</div>

<style>
    .env-card {
        background-color: #FDFBF7;
        overflow: hidden;
    }

    .env-photo {
        width: 100%;
        height: 200px;
        object-fit: cover;
        display: block;
    }

    @@media (min-width: 768px) {
        .env-photo {
            height: 240px;
        }
    }

    /* 與首頁一致：手機按鈕較好點 */
    @@media (max-width: 575.98px) {
        .env-photo {
            height: 180px;
        }

        .d-flex.flex-column > .btn {
            width: 100%;
            text-align: center;
        }
    }
</style>
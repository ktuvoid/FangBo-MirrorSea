@{
    ViewData["Title"] = "方泊 鏡海";
}

<div class="container py-4 py-md-5">
    <!-- 標題 -->
    <div class="text-center mb-4 mb-md-5 px-2">
        <h1 class="display-5 display-md-4 fw-bold" style="color:#1E1E1E;">方泊</h1>
        <p class="lead mb-0" style="color:#8C6E5A;">心理諮商與心靈繪圖空間</p>
    </div>

    <!-- 主要卡片 -->
    <div class="row g-3 g-md-4 justify-content-center">
        <!-- 關於方泊 -->
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0" style="background-color:#FDFBF7;">
                <div class="card-body d-flex flex-column p-3 p-md-4">
                    <h5 class="card-title">關於方泊</h5>
                    <p class="card-text flex-grow-1">
                        提供專業心理諮商服務，營造低飽和、自然、溫潤的空間氛圍，讓你在安定中被好好傾聽。
                    </p>
                    <p class="small text-muted mb-0">高雄市三民區建元路56號2樓</p>
                    <a asp-controller="Home" asp-action="About"
                       class="btn btn-outline-dark btn-sm mt-3 align-self-start">
                        了解更多
                    </a>
                </div>
            </div>
        </div>

        <!-- 繪圖專區 -->
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0" style="background-color:#FDFBF7;">
                <div class="card-body d-flex flex-column p-3 p-md-4">
                    <h5 class="card-title">繪圖專區</h5>
                    <p class="card-text flex-grow-1">
                        用畫筆表達情緒，留下屬於自己的作品。
                    </p>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Home" asp-action="Drawing"
                           class="btn btn-primary mt-3 align-self-start">進入繪圖</a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login"
                           class="btn btn-outline-dark mt-3 align-self-start">登入後使用</a>
                    }
                </div>
            </div>
        </div>

        <!-- 科普文章（補第三欄，小螢幕也好排） -->
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0" style="background-color:#FDFBF7;">
                <div class="card-body d-flex flex-column p-3 p-md-4">
                    <h5 class="card-title">科普文章</h5>
                    <p class="card-text flex-grow-1">
                        認識心理與情緒，用溫柔的方式靠近自己。
                    </p>
                    <a asp-controller="Home" asp-action="Articles"
                       class="btn btn-outline-dark mt-3 align-self-start">閱讀文章</a>
                </div>
            </div>
        </div>
    </div>

    <!-- 快速功能 -->
    <div class="row mt-4 mt-md-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm" style="background:#F2E6D2;">
                <div class="card-body p-3 p-md-4">
                    <h5 class="mb-3">快速功能</h5>
                    <div class="d-flex flex-column flex-sm-row flex-wrap gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Profile" asp-action="Index"
                               class="btn btn-outline-dark">個人檔案</a>
                            <a asp-controller="Home" asp-action="Chat"
                               class="btn btn-outline-dark">吐槽空間</a>
                            <a asp-controller="Home" asp-action="Drawing"
                               class="btn btn-outline-dark">繪圖專區</a>
                            <a asp-controller="Home" asp-action="ReportError"
                               class="btn btn-outline-dark">問題回報</a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login"
                               class="btn btn-primary">登入</a>
                            <a asp-controller="Account" asp-action="Register"
                               class="btn btn-outline-dark">註冊</a>
                        }

                        @if (User.IsInRole("counselor") || User.IsInRole("admin"))
                        {
                            <a asp-controller="Counselor" asp-action="Index"
                               class="btn btn-primary">諮商師介面</a>
                        }
                        @if (User.IsInRole("admin"))
                        {
                            <a asp-controller="Admin" asp-action="Index"
                               class="btn btn-primary">管理員後台</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* 手機按鈕可滿寬，較好點 */
    @@media (max-width: 575.98px) {
        .card .btn.align-self-start {
            width: 100%;
            text-align: center;
        }

        .card-body .d-flex.flex-column > .btn {
            width: 100%;
        }
    }
</style>
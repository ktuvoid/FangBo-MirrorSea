@model List<MirrorSea.Models.TeamMember>
@{
    ViewData["Title"] = "焦慮症諮商 - 方泊 鏡海";
}

<div class="container py-4 py-md-5">
    <!-- 標題 -->
    <div class="text-center mb-4 mb-md-5 px-2">
        <h1 class="fw-bold mb-2" style="color:#1E1E1E;">焦慮症／憂鬱相關諮商</h1>
        <p class="lead mb-0" style="color:#8C6E5A;">
            在安全、被理解的空間裡，慢慢放鬆緊繃的弦
        </p>
    </div>

    <!-- 引言 -->
    <div class="card border-0 shadow-sm mb-4" style="background-color:#F9F5F0;">
        <div class="card-body p-3 p-md-4">
            <p class="mb-2">
                焦慮與憂鬱有時像一根拉得很緊的弦，心跳加速、思緒混亂，
                彷彿站在懸崖邊。方泊心理諮商所提供專業支持，協助你學習放鬆這根弦，
                讓心靈有喘息的空間，並在歷程中逐步重拾生活的力量。
            </p>
            <p class="mb-0 text-muted small">
                我們重視建立安全、支持的治療關係，並依每個人的經歷與需求調整方向，
                無論透過個別諮商、放鬆與情緒調節技巧，或持續的陪伴與鼓勵。
            </p>
        </div>
    </div>

    <!-- 為何需要 -->
    <div class="card border-0 shadow-sm mb-4" style="background-color:#FDFBF7;">
        <div class="card-body p-3 p-md-4">
            <h5 class="mb-3" style="color:#8C6E5A;">為什麼會需要心理諮商？</h5>
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <p class="mb-1 fw-semibold">1. 情緒困擾</p>
                    <p class="small text-muted mb-3">
                        憂鬱、焦慮等情緒問題，透過諮商梳理壓力來源，調整生活節奏。
                    </p>
                    <p class="mb-1 fw-semibold">2. 關係困擾</p>
                    <p class="small text-muted mb-0">
                        伴侶、親子、人際等角色中的摩擦，找到心裡的疙瘩與較合適的相處方式。
                    </p>
                </div>
                <div class="col-12 col-md-6">
                    <p class="mb-1 fw-semibold">3. 身心議題</p>
                    <p class="small text-muted mb-3">
                        睡不好、患得患失、注意力不集中等，除生理因素外，也可一起了解心理源頭。
                    </p>
                    <p class="mb-1 fw-semibold">4. 自我成長與探索</p>
                    <p class="small text-muted mb-0">
                        看見舊有模式，嘗試新的行為，朝更理想的自己靠近。
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- 諮商能帶來什麼 -->
    <div class="card border-0 shadow-sm mb-4" style="background-color:#FDFBF7;">
        <div class="card-body p-3 p-md-4">
            <h5 class="mb-3" style="color:#8C6E5A;">在諮商室裡，我們可以一起做什麼？</h5>
            <p class="mb-2">
                治療核心是<strong>安全、被理解與接納</strong>的環境，並依你的狀況調整方法：
            </p>
            <ul class="mb-3 ps-3">
                <li class="mb-2">認識焦慮／憂鬱的訊號，降低自我苛責</li>
                <li class="mb-2">學習放鬆、情緒調節與壓力因應技巧</li>
                <li class="mb-2">釐清與生活、關係交織的壓力來源</li>
                <li>在穩定的關係中，一步步建立自信與力量</li>
            </ul>
            <p class="small text-muted mb-0">
                諮商可能帶來的改變包括：較好的情緒管理、關係敏感度、認知與自律習慣，
                以及與自己更和諧的相處。
            </p>
        </div>
    </div>

    <!-- 服務說明 -->
    <div class="row g-3 g-md-4 mb-4">
        <div class="col-12 col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="background-color:#F2E6D2;">
                <div class="card-body p-3 p-md-4">
                    <h5 class="mb-3" style="color:#8C6E5A;">個別諮商</h5>
                    <p class="small text-muted mb-2">適合這樣的你／妳：</p>
                    <ul class="small mb-3 ps-3">
                        <li>長期焦慮、恐慌或情緒低落</li>
                        <li>壓力大、睡不好、注意力難集中</li>
                        <li>希望有人陪著整理思緒與生活節奏</li>
                        <li>想學習較有效的情緒與壓力因應方式</li>
                    </ul>
                    <p class="mb-1"><strong>時長</strong>：約 50 分鐘／節</p>
                    <p class="mb-0"><strong>費用</strong>：約 2,000～2,500 元／節</p>
                    <p class="small text-muted mt-2 mb-0">實際費用依心理師資歷略有不同，預約時會事先說明。</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="background-color:#F2E6D2;">
                <div class="card-body p-3 p-md-4">
                    <h5 class="mb-3" style="color:#8C6E5A;">其他相關服務</h5>
                    <p class="mb-2"><strong>通訊諮商</strong></p>
                    <p class="small mb-2">
                        異地或不便到場時，可討論視訊等方式；原則上建議至少有一次實體見面。
                    </p>
                    <p class="small mb-1">時長：約 50 分鐘／節</p>
                    <p class="small mb-3">費用：約 2,000～2,500 元／節</p>
                    <p class="mb-2"><strong>心理測驗與解釋</strong></p>
                    <p class="small mb-0">
                        可依需求安排標準化測驗與解釋晤談，協助釐清情緒與核心議題。
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- 相關專長心理師 -->
    <h5 class="mb-3" style="color:#8C6E5A;">相關專長心理師</h5>
    <p class="small text-muted mb-3">點選卡片可查看該心理師完整介紹。實際媒合以初談與排班為準。</p>

    <div class="row g-3 g-md-4 mb-4">
        @if (Model != null && Model.Count > 0)
        {
            @foreach (var m in Model)
            {
                <div class="col-12 col-sm-6 col-lg-4">
                    <a asp-controller="Home" asp-action="TeamDetail"
                       asp-route-slug="@m.Slug"
                       class="text-decoration-none text-dark">
                        <div class="card h-100 shadow-sm border-0" style="background-color:#F9F5F0;">
                            <div class="card-body p-3 p-md-4 d-flex flex-column">
                                <div class="d-flex align-items-center mb-3">
                                    @if (!string.IsNullOrEmpty(m.PhotoUrl))
                                    {
                                        <img src="@m.PhotoUrl"
                                             alt="@m.Name"
                                             class="rounded-circle me-3"
                                             style="width:70px;height:70px;object-fit:cover;flex-shrink:0;border:2px solid #B7ADA0;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                             style="width:70px;height:70px;background:#B7ADA0;color:white;font-size:1.2rem;flex-shrink:0;">
                                            @m.Initial
                                        </div>
                                    }
                                    <div>
                                        <h5 class="mb-0 fw-bold" style="color:#1E1E1E;">@m.Name</h5>
                                        <p class="mb-1 text-muted small">@(m.Title ?? "諮商心理師")</p>
                                        @if (m.IsFangboCounselor)
                                        {
                                            <span class="badge rounded-pill"
                                                  style="background-color:#8C6E5A;color:white;font-size:0.7rem;">
                                                方泊諮商所 諮商心理師
                                            </span>
                                        }
                                        @if (m.IsFangboClinical)
                                        {
                                            <span class="badge rounded-pill"
                                                  style="background-color:#5A6E8C;color:white;font-size:0.7rem;">
                                                方泊諮商所 臨床心理師
                                            </span>
                                        }
                                    </div>
                                </div>

                                @if (m.SpecialtyList.Count > 0)
                                {
                                    <ul class="small mb-3 ps-3 flex-grow-1">
                                        @foreach (var s in m.SpecialtyList.Take(4))
                                        {
                                            <li>@s</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <div class="flex-grow-1"></div>
                                }

                                <div class="mt-auto text-end">
                                    <span class="small" style="color:#8C6E5A;">查看詳細介紹 →</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <p class="text-muted small mb-0">目前尚無相關心理師資料。</p>
            </div>
        }
    </div>

    <!-- 營業與 CTA -->
    <div class="card border-0 shadow-sm mb-4" style="background-color:#F9F5F0;">
        <div class="card-body p-3 p-md-4">
            <h5 class="mb-3" style="color:#8C6E5A;">服務時間</h5>
            <p class="mb-1">週一至週日</p>
            <p class="mb-0">09:00～12:00　｜　14:00～17:00　｜　18:00～21:00</p>
            <p class="small text-muted mt-2 mb-0">
                <strong>地址</strong><br>
                <a href="https://maps.app.goo.gl/pUnbRrGkPmbCdD1d9" target="_blank" rel="noopener" class="l-link">
                    高雄市三民區建元路56號2樓
                </a>
            </p>
        </div>
    </div>

    <div class="d-flex flex-column flex-sm-row flex-wrap gap-2 justify-content-center">
        <a asp-controller="Home" asp-action="Contact" class="btn btn-primary">聯絡／預約諮詢</a>
        <a asp-controller="Home" asp-action="Team" class="btn btn-outline-dark">認識諮商團隊</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">返回首頁</a>
    </div>
</div>

<style>
    @@media (max-width: 575.98px) {
        .d-flex.flex-column > .btn {
            width: 100%;
            text-align: center;
        }
    }
</style>
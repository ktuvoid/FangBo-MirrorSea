@model List<MirrorSea.Models.NewsItem>
@{
    ViewData["Title"] = "最新消息 - 方泊 鏡海";
}

<div class="container py-4 py-md-5">
    <div class="text-center mb-4 mb-md-5 px-2">
        <h1 class="fw-bold mb-2" style="color:#1E1E1E;">最新消息</h1>
        <p class="lead mb-0" style="color:#8C6E5A;">活動花絮、課程與服務公告</p>
    </div>

    <div class="row g-3 g-md-4">
        @if (Model != null)
        {
            @foreach (var n in Model)
            {
                <div class="col-12 col-md-6">
                    <a asp-controller="Home" asp-action="NewsDetail"
                       asp-route-slug="@n.Slug"
                       class="text-decoration-none text-dark">
                        <div class="card h-100 border-0 shadow-sm" style="background-color:#FDFBF7;">
                            <div class="card-body p-3 p-md-4 d-flex flex-column">
                                <span class="badge rounded-pill align-self-start mb-2"
                                      style="background-color:#8C6E5A;color:#fff;font-size:0.7rem;">
                                    @n.Category
                                </span>
                                <h5 class="mb-2 fw-semibold" style="color:#1E1E1E;font-size:1.1rem;">@n.Title</h5>
                                <p class="small flex-grow-1 mb-3" style="color:#5A4A3A;line-height:1.7;">@n.Summary</p>
                                <div class="mt-auto text-end">
                                    <span class="small" style="color:#8C6E5A;">閱讀更多 →</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        }
    </div>

    <div class="d-flex flex-wrap gap-2 justify-content-center mt-4">
        <a asp-controller="Home" asp-action="Appointment" class="btn btn-outline-dark">預約流程</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">返回首頁</a>
    </div>
</div>
@{
    ViewData["Title"] = "預約流程 - 方泊 鏡海";
}

<div class="container py-4 py-md-5">
    <div class="text-center mb-4 mb-md-5 px-2">
        <h1 class="fw-bold mb-2" style="color:#1E1E1E;">預約流程</h1>
        <p class="lead mb-0" style="color:#8C6E5A;">
            簡單三步驟，開始你的諮商安排
        </p>
    </div>

    <!-- 可預約時段 -->
    <div class="card border-0 shadow-sm mb-4" style="background-color:#F9F5F0;">
        <div class="card-body p-3 p-md-4">
            <h5 class="mb-2" style="color:#8C6E5A;">可預約時段</h5>
            <p class="mb-1">週一至週日，上午九點至晚間九點。</p>
        </div>
    </div>

    <!-- 預約步驟 -->
    <h5 class="mb-3" style="color:#8C6E5A;">預約流程</h5>
    <div class="row g-3 g-md-4 mb-4">
        <div class="col-12 col-md-4">
            <div class="card h-100 border-0 shadow-sm" style="background-color:#FDFBF7;">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="rounded-circle d-flex align-items-center justify-content-center me-2 flex-shrink-0"
                              style="width:36px;height:36px;background:#8C6E5A;color:#fff;font-weight:600;">1</span>
                        <h5 class="mb-0">填寫初談表</h5>
                    </div>
                    <p class="mb-md-0">
                        成人／一般諮商請填寫「<a href="https://docs.google.com/forms/d/e/1FAIpQLSfWR_IEMMNjSGnYMqNAehbURyO39E0sM_CoUyf74rpEovDrEA/viewform" target="_blank" rel="noopener" class="l-link">
                            訪客預約初談表
                        </a>」；
                        兒童諮商請填寫「<a href="https://docs.google.com/forms/d/e/1FAIpQLSdqUZc_3lQxsaZ8RleFW8-1WbgZ9U2mpRmN66EZkeEmnGzQ4A/viewform" target="_blank" rel="noopener" class="l-link">
                            兒童預約初談表
                        </a>」。
                    </p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 border-0 shadow-sm" style="background-color:#FDFBF7;">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="rounded-circle d-flex align-items-center justify-content-center me-2 flex-shrink-0"
                              style="width:36px;height:36px;background:#8C6E5A;color:#fff;font-weight:600;">2</span>
                        <h5 class="mb-0">LINE 告知完成</h5>
                    </div>
                    <p class="mb-md-0">
                        填寫完成後，請以 LINE 訊息告知已完成填表，方便我們盡快為您媒合與確認。
                    </p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 border-0 shadow-sm" style="background-color:#FDFBF7;">
                <div class="card-body p-3 p-md-4">
                    <div class="d-flex align-items-center mb-3">
                        <span class="rounded-circle d-flex align-items-center justify-content-center me-2 flex-shrink-0"
                              style="width:36px;height:36px;background:#8C6E5A;color:#fff;font-weight:600;">3</span>
                        <h5 class="mb-0">等待確認預約</h5>
                    </div>
                    <p class="mb-md-0">
                        我們會於<strong>三天內</strong>盡速為您完成預約安排，並透過 LINE 回覆確認。
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- LINE 聯絡 -->
    <div class="card border-0 shadow-sm mb-4" style="background-color:#F2E6D2;">
        <div class="card-body p-3 p-md-4">
            <h5 class="mb-0" style="color:#8C6E5A;">官方 LINE</h5>
            <p class="mb-0">
                <strong>LINE ID</strong>：
                <a href="https://line.me/R/ti/p/@@090pwvrg" target="_blank" rel="noopener"
                   class="text-decoration-none" style="color:#1E1E1E;">
                    @@090pwvrg
                </a>
            </p>
            <p class="small text-muted mb-0">
                加入好友後，可告知欲預約類型（個別／伴侶／兒童等），並在填表後回報完成。
            </p>
        </div>
    </div>

    <!-- 提醒 -->
    <div class="card border-0 shadow-sm mb-4" style="background-color:#F9F5F0;">
        <div class="card-body p-3 p-md-4">
            <h5 class="mb-3 fw-semibold" style="color:#8C6E5A;font-size:1.15rem;">到訪提醒</h5>
            <ul class="mb-0 ps-3" style="line-height:1.7;color:#5A4A3A;">
                <li class="mb-2">服務採預約制，請依約定時間到達。</li>
                <li class="mb-2">空間以安靜為主，請避免大聲通話或錄音錄影。</li>
                <li class="mb-2">會談內容受專業倫理保護。</li>
                <li>若有無障礙或其他特殊需求，歡迎事先告知。</li>
            </ul>
        </div>
    </div>

    <!-- 地址與時間 -->
    <div class="row g-3 g-md-4 mb-4">
        <div class="col-12 col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="background-color:#F2E6D2;">
                <div class="card-body p-3 p-md-4">
                    <h4 class="mb-3 fw-semibold" style="color:#8C6E5A;font-size:1.15rem;">地址</h4>
                    <p class="mb-0" style="line-height:1.7;color:#5A4A3A;">
                        <a href="https://maps.app.goo.gl/pUnbRrGkPmbCdD1d9"
                           target="_blank" rel="noopener"
                           class="l-link">
                            高雄市三民區建元路 56 號 2 樓
                        </a>
                    </p>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="background-color:#F2E6D2;">
                <div class="card-body p-3 p-md-4">
                    <h4 class="mb-3 fw-semibold" style="color:#8C6E5A;font-size:1.15rem;">營業時間</h4>
                    <p class="mb-2" style="line-height:1.7;color:#5A4A3A;">週一至週日</p>
                    <p class="mb-0" style="line-height:1.7;color:#5A4A3A;">09:00～12:00　｜　14:00～17:00　｜　18:00～21:00</p>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-column flex-sm-row flex-wrap gap-2 justify-content-center">
        <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-dark">聯絡我們</a>
        <a asp-controller="Home" asp-action="Services" class="btn btn-outline-dark">諮商項目</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">返回首頁</a>
    </div>
</div>

<style>
    @@media (max-width: 575.98px) {
        .d-flex.flex-column > .btn {
            width: 100%;
            text-align: center;
        }
    }
</style>
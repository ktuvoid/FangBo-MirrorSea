@{
    ViewData["Title"] = "諮商項目 - 方泊 鏡海";
}

<div class="container py-4 py-md-5">
    <div class="text-center mb-4 mb-md-5 px-2">
        <h1 class="fw-bold mb-2" style="color:#1E1E1E;">諮商項目</h1>
        <p class="lead mb-0" style="color:#8C6E5A;">
            依你的需求，找到適合的諮商與支持方式
        </p>
    </div>

    <div class="row g-3 g-md-4">

        <!-- 個別諮商 -->
        <div class="col-12 col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="background-color:#FDFBF7;">
                <div class="card-body p-3 p-md-4 d-flex flex-column">
                    <h5 class="mb-3" style="color:#8C6E5A;">個別諮商</h5>
                    <p class="small mb-2">你／妳是否有些長期困擾自己的議題？</p>
                    <ul class="small mb-3 ps-3 flex-grow-1">
                        <li>某些情緒始終無法控制，影響自己也影響他人</li>
                        <li>某些行為不自覺一直重複發生</li>
                        <li>腦海裡好多想法一片混亂</li>
                        <li>未來應該何去何從，或關係裡卡住了</li>
                    </ul>
                    <p class="small text-muted mb-2">
                        透過心理師，在一段時間裡高品質地專注在個人議題上，給自己一段善待生命議題的時間。
                    </p>
                    <p class="mb-0 small"><strong>時長</strong>：50 分鐘／節</p>
                    <p class="mb-0 small"><strong>費用</strong>：約 2,200～3,000 元／節</p>
                </div>
            </div>
        </div>

        <!-- 伴侶諮商 -->
        <div class="col-12 col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="background-color:#FDFBF7;">
                <div class="card-body p-3 p-md-4 d-flex flex-column">
                    <h5 class="mb-3" style="color:#8C6E5A;">伴侶諮商</h5>
                    <ul class="small mb-3 ps-3 flex-grow-1">
                        <li>他／她又找我吵架了</li>
                        <li>我忍受他／她好多年了</li>
                        <li>信任出現裂痕，不知該復合還是結束</li>
                        <li>安全感、價值觀、生活習慣談不攏</li>
                    </ul>
                    <p class="small text-muted mb-2">
                        雙方透過心理師協助，給關係一次檢視、核對、表達、溝通與重塑的機會。
                    </p>
                    <p class="mb-0 small"><strong>時長</strong>：80 分鐘／節</p>
                    <p class="mb-0 small"><strong>費用</strong>：約 3,000～4,500 元／節</p>
                    <a asp-controller="Home" asp-action="CoupleCounseling"
                       class="btn btn-sm btn-outline-dark mt-3 align-self-start">了解更多</a>
                </div>
            </div>
        </div>

        <!-- 兒童及青少年諮商 -->
        <div class="col-12 col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="background-color:#FDFBF7;">
                <div class="card-body p-3 p-md-4 d-flex flex-column">
                    <h5 class="mb-3" style="color:#8C6E5A;">兒童及青少年諮商</h5>
                    <p class="small mb-2">孩子還是有這些狀況嗎？</p>
                    <ul class="small mb-3 ps-3 flex-grow-1">
                        <li>情緒起伏不定</li>
                        <li>同儕關係緊張</li>
                        <li>親子衝突不斷</li>
                        <li>好動不專心，或安靜沒活力</li>
                    </ul>
                    <p class="small text-muted mb-2">
                        透過心理師更深入了解孩子，也讓孩子更認識自己，找回成長的動力與快樂。
                    </p>
                    <p class="mb-0 small"><strong>時長</strong>：50 分鐘／節（含家長晤談）</p>
                    <p class="mb-0 small"><strong>費用</strong>：約 2,200～3,000 元／節</p>
                    <a asp-controller="Home" asp-action="ChildCounseling"
                       class="btn btn-sm btn-outline-dark mt-3 align-self-start">了解更多</a>
                </div>
            </div>
        </div>

        <!-- 團體諮商 -->
        <div class="col-12 col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="background-color:#FDFBF7;">
                <div class="card-body p-3 p-md-4 d-flex flex-column">
                    <h5 class="mb-3" style="color:#8C6E5A;">團體諮商</h5>
                    <ul class="small mb-3 ps-3 flex-grow-1">
                        <li>擔心一個人面對心理師不知從何開始</li>
                        <li>希望多聽他人故事，才有勇氣表達自己</li>
                        <li>想與人有較深層的互動與連結，卻缺乏機會</li>
                    </ul>
                    <p class="small text-muted mb-2">
                        籌組相似議題的夥伴，在心理師帶領下彼此訴說、傾聽與療癒。
                    </p>
                    <p class="mb-0 small"><strong>方式</strong>：4～8 人，約 2 個月一期</p>
                    <p class="mb-0 small"><strong>時長</strong>：每週一次、每次 2 小時（八週約 16 小時）</p>
                    <p class="mb-0 small"><strong>費用</strong>：視活動內容而定</p>
                </div>
            </div>
        </div>

        <!-- 性諮商 -->
        <div class="col-12 col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="background-color:#FDFBF7;">
                <div class="card-body p-3 p-md-4 d-flex flex-column">
                    <h5 class="mb-3" style="color:#8C6E5A;">性諮商</h5>
                    <p class="small mb-2 flex-grow-1">
                        當你對「性」感到困惑、抗拒、沒興趣，甚至有創傷記憶，這些都可以談。
                        性諮商不是要改變你，而是陪你更認識自己的身體、慾望與界線；
                        談的不只是性愛，也包括親密的距離、被碰觸的感受，以及說不出口的心事。
                    </p>
                    <p class="mb-0 small"><strong>時長</strong>：50 分鐘／節</p>
                    <p class="mb-0 small"><strong>費用</strong>：約 3,000 元／節</p>
                </div>
            </div>
        </div>

        <!-- 心理課程 -->
        <div class="col-12 col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="background-color:#FDFBF7;">
                <div class="card-body p-3 p-md-4 d-flex flex-column">
                    <h5 class="mb-3" style="color:#8C6E5A;">心理課程</h5>
                    <p class="small mb-2 flex-grow-1">
                        戲劇、政治、藝術、電影、書籍……除了個別與團體諮商，
                        也可用體驗活動獲得不一樣的成長。不同媒材帶出不同體驗，歡迎參與沉浸式心理課程。
                    </p>
                    <p class="mb-0 small"><strong>人數／費用</strong>：視活動內容而定</p>
                </div>
            </div>
        </div>

        <!-- 通訊諮商 -->
        <div class="col-12 col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="background-color:#F2E6D2;">
                <div class="card-body p-3 p-md-4 d-flex flex-column">
                    <h5 class="mb-3" style="color:#8C6E5A;">通訊諮商、諮詢</h5>
                    <p class="small mb-2 flex-grow-1">
                        不便前來時，可討論視訊等方式。通訊與實體諮商有差異，
                        實體較能觀察肢體語言與空間互動。若在國外或異地，方泊仍可提供視訊陪伴；
                        原則上建議至少有一次實體見面，詳情請<a href="tel:07-395-9000" target="_blank" rel="noopener" class="l-link">
                            來電
                        </a>或官方
                        <a href="https://line.me/R/ti/p/@@090pwvrg" target="_blank" rel="noopener" class="l-link">
                            Line
                        </a>洽詢。
                    </p>
                    <p class="mb-0 small"><strong>時長</strong>：50 分鐘／節</p>
                    <p class="mb-0 small"><strong>費用</strong>：約 2,200～3,000 元／節</p>
                </div>
            </div>
        </div>

        <!-- 心理測驗 -->
        <div class="col-12 col-md-6">
            <div class="card h-100 border-0 shadow-sm" style="background-color:#F2E6D2;">
                <div class="card-body p-3 p-md-4 d-flex flex-column">
                    <h5 class="mb-3" style="color:#8C6E5A;">心理測驗與解釋</h5>
                    <p class="small mb-2 flex-grow-1">
                        「我是誰？可以依循什麼方向較安心？」看不見的心理狀態，
                        可透過標準化測驗形成報告並討論。從初步晤談到施測、解釋與晤談，
                        協助把困惑具體化，找到想處理的核心議題。
                    </p>
                    <p class="mb-0 small"><strong>時長／費用</strong>：視測驗內容而定</p>
                </div>
            </div>
        </div>
    </div>

    <!-- 服務時間與地址 -->
    <div class="card border-0 shadow-sm mt-4 mb-4" style="background-color:#F9F5F0;">
        <div class="card-body p-3 p-md-4">
            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <h5 class="mb-2" style="color:#8C6E5A;">服務時間</h5>
                    <p class="mb-1">週一至週日</p>
                    <p class="mb-0">09:00～12:00　｜　14:00～17:00　｜　18:00～21:00</p>
                </div>
                <div class="col-12 col-md-6">
                    <h5 class="mb-2" style="color:#8C6E5A;">地址</h5>
                    <p class="mb-0">
                        <a href="https://maps.app.goo.gl/pUnbRrGkPmbCdD1d9" target="_blank" rel="noopener" class="l-link">
                            高雄市三民區建元路56號2樓
                        </a>
                    </p>
                    <p class="small text-muted mb-0 mt-1">服務採預約制</p>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex flex-column flex-sm-row flex-wrap gap-2 justify-content-center">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">高雄心理諮商所推薦</a>
        <a asp-controller="Home" asp-action="ChildCounseling" class="btn btn-outline-dark">高雄兒童心理諮商</a>
        <a asp-controller="Home" asp-action="Team" class="btn btn-primary">高雄心理醫師推薦</a>
        <a asp-controller="Home" asp-action="CoupleCounseling" class="btn btn-outline-dark">高雄婚姻諮商推薦、高雄伴侶諮商</a>
        <a asp-controller="Home" asp-action="AnxietyCounseling" class="btn btn-outline-dark">高雄焦慮症、高雄憂鬱症</a>
    </div>
</div>

<style>
    @@media (max-width: 575.98px) {
        .d-flex.flex-column > .btn {
            width: 100%;
            text-align: center;
        }
    }
</style>
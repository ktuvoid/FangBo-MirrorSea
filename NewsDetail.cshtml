@model MirrorSea.Models.NewsItem
@{
    ViewData["Title"] = Model.Title + " - 方泊 鏡海";
}

<div class="container py-4 py-md-5">
    <div class="mb-3">
        <a asp-controller="Home" asp-action="News" class="text-decoration-none small" style="color:#8C6E5A;">
            ← 返回最新消息
        </a>
    </div>

    <article class="card border-0 shadow-sm" style="background-color:#F9F5F0;">
        <div class="card-body p-3 p-md-5">
            <span class="badge rounded-pill mb-3"
                  style="background-color:#8C6E5A;color:#fff;font-size:0.75rem;">
                @Model.Category
            </span>
            <h1 class="fw-bold mb-3" style="color:#1E1E1E;font-size:1.6rem;">
                @Model.Title
            </h1>
            @if (Model.PublishedAt.HasValue)
            {
                <p class="small text-muted mb-4">
                    @Model.PublishedAt.Value.ToString("yyyy/MM/dd")
                </p>
            }
            <div class="news-content" style="color:#5A4A3A;line-height:1.85;font-size:1.05rem;">
                @Html.Raw(Model.Content)
            </div>
        </div>
    </article>

    <div class="d-flex flex-column flex-sm-row flex-wrap gap-2 justify-content-center mt-4">
        <a asp-controller="Home" asp-action="News" class="btn btn-outline-dark">全部消息</a>
        <a href="https://line.me/R/ti/p/@@090pwvrg" target="_blank" rel="noopener" class="btn btn-primary">官方 LINE</a>
        <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-secondary">聯絡我們</a>
    </div>
</div>

<style>
    .news-content p { margin-bottom: 1rem; }
    .news-content ol, .news-content ul { padding-left: 1.25rem; margin-bottom: 1rem; }
    .news-content li { margin-bottom: 0.35rem; }
    @@media (max-width: 575.98px) {
        .d-flex.flex-column > .btn { width: 100%; text-align: center; }
    }
</style>